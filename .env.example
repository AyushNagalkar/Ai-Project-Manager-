# ── MongoDB ──────────────────────────────────────
# NOTE: backend-node/src/config/database.js reads MONGO_URI
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smartpm?retryWrites=true&w=majority

# ── JWT Secret ───────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here

# ── OpenRouter API Key ───────────────────────────
# All 4 AI agents use this single key via OpenRouter
# Model: stepfun/step-3.5-flash:free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Service URLs ─────────────────────────────────
BACKEND_URL=http://localhost:5000
ORCHESTRATOR_URL=http://localhost:8000
PLANNER_SERVICE_URL=http://localhost:8001
RESEARCH_SERVICE_URL=http://localhost:8002
MONITOR_SERVICE_URL=http://localhost:8003
DOC_SERVICE_URL=http://localhost:8004
OCR_SERVICE_URL=http://localhost:8005

# ── Frontend ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development
